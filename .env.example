DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/aether.db
# Internal FastAPI (bot + engine) — bound to loopback, proxied by the Next.js console
API_PORT=8457
API_HOST=127.0.0.1
LOG_LEVEL=INFO

# Model inference backend (Ollama, local-first)
OLLAMA_BASE_URL=http://localhost:11434
# Pick a model that fits your machine's RAM: llama3 (8B) needs ~6GB free and
# gets OOM-killed on small VPSes — use llama3.2:1b or qwen2.5:0.5b there.
OLLAMA_MODEL=llama3

# Telegram bot bridge (optional; wired via the /setup page)
# Get a token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AGENT_ID=aria
TELEGRAM_ENABLED=false
# Chat/user id to notify when the agent activates (optional, from @userinfobot)
TELEGRAM_CHAT_ID=