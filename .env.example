DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/aether.db
# Internal FastAPI (bot + engine) — bound to loopback, proxied by the Next.js console
API_PORT=8457
API_HOST=127.0.0.1
LOG_LEVEL=INFO

# Model inference backend — local-first
OLLAMA_BASE_URL=http://localhost:11434
# Local model that fits your machine's RAM: llama3 (8B) needs ~6GB free and
# gets OOM-killed on small VPSes — use llama3.2:1b or qwen2.5:0.5b there.
OLLAMA_MODEL=llama3

# Provider routing: "ollama" (local, no key) or a remote provider id
# (openai | openrouter | groq | deepseek | xai | gemini | anthropic).
# Each remote provider reads its key from its own env var below.
MODEL_PROVIDER=ollama
MODEL_NAME=
# Generic key override for remote providers (per-provider env vars win).
PROVIDER_API_KEY=

# Remote provider keys (set the one matching MODEL_PROVIDER):
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram bot bridge (optional; wired via the /setup page)
# Get a token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AGENT_ID=aria
TELEGRAM_ENABLED=false
# Chat/user id to notify when the agent activates (optional, from @userinfobot)
TELEGRAM_CHAT_ID=
# Allowlist: comma-separated Telegram user IDs that may talk to the bot.
# Empty = everyone (or set TELEGRAM_ALLOW_ALL_USERS=true for dev).
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOW_ALL_USERS=false