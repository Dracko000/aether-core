[Unit]
Description=Aether Core web console (Next.js, public :8456)
After=network-online.target aether.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/aether/web/.next/standalone
Environment=PORT=8456
Environment=HOSTNAME=0.0.0.0
Environment=AETHER_API_BASE=http://127.0.0.1:8457
ExecStart=/root/.nvm/versions/node/v24.19.0/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target