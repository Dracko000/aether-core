[Unit]
Description=Aether Core API server (internal, bot + engine)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/aether
# '-' prefix: tolerate missing .env (Settings falls back to defaults)
EnvironmentFile=-/root/aether/.env
ExecStart=/root/aether/.venv/bin/python -m uvicorn aether.api.app:app --host 127.0.0.1 --port 8457
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target